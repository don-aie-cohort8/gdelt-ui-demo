# GDELT UI Demo - Environment Configuration
# Copy this file to .env.local and configure for your environment

# ======================
# Backend API Configuration
# ======================

# LangGraph Server base URL
# Default: http://localhost:2024 (local development)
# Production: Update to your deployed backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:2024

# API request timeout in milliseconds
# Default: 30000 (30 seconds)
# Adjust based on your backend response times
NEXT_PUBLIC_API_TIMEOUT=30000

# ======================
# Optional: LangSmith Tracing
# ======================
# Enable these if you want to use LangSmith for tracing
# Requires corresponding configuration in the backend

# NEXT_PUBLIC_LANGSMITH_TRACING=false
# NEXT_PUBLIC_LANGSMITH_PROJECT=gdelt-knowledge-base

# ======================
# Development Notes
# ======================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Backend must be running on the configured URL for queries to work
# - Start backend with: cd ../gdelt-knowledge-base && langgraph dev
# - Health check endpoint: {NEXT_PUBLIC_API_BASE_URL}/ok
